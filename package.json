{
  "name": "date-night",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Swipe together, match on a spot, and we book it.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:app": "VITE_BACKEND=local vite build",
    "ios": "npm run build:app && npx cap sync ios && npx cap open ios",
    "ios:sync": "npm run build:app && npx cap sync ios",
    "build:share": "vite build -c vite.artifact.config.ts",
    "ios:online": "VITE_API_URL=$API_URL npm run build:app && npx cap sync ios && npx cap open ios",
    "build:vercel": "node scripts/build-vercel.mjs",
    "ios:prod": "API_URL=https://date-night-swart.vercel.app npm run ios:online"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
